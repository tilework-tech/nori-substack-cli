{
  "name": "nori-substack-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for authenticated and unauthenticated Substack operations",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "nori-substack": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepack": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilework-tech/nori-substack-cli.git"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "commander": "^13.1.0",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^3.2.7"
  }
}
